# ── Visitor tracking ──────────────────────────────────────────────────────────
# Required: Supabase project credentials
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Required: Password to access colt.fyi/dashboard
VITE_DASHBOARD_PASSWORD=your_secret_dashboard_password

# Analytics ingestion endpoint (client → edge function). Default is the Netlify
# same-origin proxy '/api/collect' (see public/_redirects), which is not
# ad-blockable. Only override to hit the function directly (e.g. local dev).
VITE_INGEST_URL=/api/collect

# ── Supabase Edge Function `ingest` secrets (set with the Supabase CLI, NOT here;
#    these are server-side only and must never be VITE_-prefixed/client-exposed):
#      supabase secrets set OWNER_TOKEN=<long-random-secret>
#      supabase secrets set IPINFO_TOKEN=<ipinfo.io token>   # optional; omit to use keyless ipwho.is
#    (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
#
# OWNER_TOKEN is also how you mark your own devices: visit
#   https://colt.fyi/?owner=<OWNER_TOKEN>
# once on any device to tag your traffic (dashboard: "Only me" / "Exclude owner").

# ── Existing vars (reference) ─────────────────────────────────────────────────
# UI-only toggle. It hides the gate during local dev; it cannot grant access,
# because the content is gated server-side.
VITE_PASSWORD_GATE_ENABLED=true

# NOTE: VITE_SITE_PASSWORD and VITE_DASHBOARD_PASSWORD are no longer read by the
# app. Anything VITE_-prefixed is inlined into the client bundle and is therefore
# public — which is why both passwords moved to the server-side vars below.

# ── Server-side only — NEVER prefix these with VITE_ ──────────────────────────
# Read by netlify/functions/*. Set them on Netlify with:
#     netlify env:set SITE_PASSWORD '<value>'
# Locally, put them in .env and run `netlify dev` (plain `vite` does not serve
# functions, so the gate cannot authenticate under `npm run dev`).
SITE_PASSWORD=your_portfolio_password
DASHBOARD_PASSWORD=your_secret_dashboard_password

# Shown to anyone who digs the "password" out of the JS bundle; submitting it
# lands them on /nedry instead of authenticating. Must match the SITE_PASSWORD
# constant in src/components/modals/PasswordGate.jsx, and must NOT equal
# SITE_PASSWORD (login.mjs refuses to authenticate if they collide).
DECOY_PASSWORD=LemonDrops

# HMAC key for session cookies. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every existing session.
AUTH_SECRET=64_hex_chars_here

# Service-role key for dashboard reads (bypasses RLS — server only, never VITE_).
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
