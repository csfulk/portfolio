# ── Visitor tracking ──────────────────────────────────────────────────────────
# Required: Supabase project credentials
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Required: Password to access colt.fyi/dashboard
VITE_DASHBOARD_PASSWORD=your_secret_dashboard_password

# Analytics ingestion endpoint (client → edge function). Default is the Netlify
# same-origin proxy '/api/collect' (see public/_redirects), which is not
# ad-blockable. Only override to hit the function directly (e.g. local dev).
VITE_INGEST_URL=/api/collect

# ── Supabase Edge Function `ingest` secrets (set with the Supabase CLI, NOT here;
#    these are server-side only and must never be VITE_-prefixed/client-exposed):
#      supabase secrets set OWNER_TOKEN=<long-random-secret>
#      supabase secrets set IPINFO_TOKEN=<ipinfo.io token>   # optional; omit to use keyless ipwho.is
#    (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)
#
# OWNER_TOKEN is also how you mark your own devices: visit
#   https://colt.fyi/?owner=<OWNER_TOKEN>
# once on any device to tag your traffic (dashboard: "Only me" / "Exclude owner").

# ── Existing vars (reference) ─────────────────────────────────────────────────
VITE_SITE_PASSWORD=your_portfolio_password
VITE_PASSWORD_GATE_ENABLED=true
